#!/usr/bin/env bash


### Restore database from a backup.
###
### Parameters:
###     <1> filename of an existing backup.
###
### Usage:
###     $ docker-compose -f <environment>.yml (exec |run --rm) postgres restore <1>
###
### Safety: the archive is checked and restored into a staging database first. The live
### database is replaced only after a fully successful restore, and is kept (renamed to
### <db>_pre_restore_<timestamp>) rather than dropped. Stop the app before restoring.


set -o errexit
set -o pipefail
set -o nounset


working_dir="$(dirname ${0})"
source "${working_dir}/_sourced/constants.sh"
source "${working_dir}/_sourced/messages.sh"


if [[ -z ${1+x} ]]; then
    message_error "Backup filename is not specified yet it is a required parameter. Make sure you provide one and try again."
    exit 1
fi
backup_filename="${BACKUP_DIR_PATH}/${1}"
if [[ ! -f "${backup_filename}" ]]; then
    message_error "No backup with the specified filename found. Check out the 'backups' maintenance script output to see if there is one and try again."
    exit 1
fi

message_welcome "Restoring the '${POSTGRES_DB}' database from the '${backup_filename}' backup..."

if [[ "${POSTGRES_USER}" == "postgres" ]]; then
    message_error "Restoring as 'postgres' user is not supported. Assign 'POSTGRES_USER' env with another one and try again."
    exit 1
fi

export PGHOST="${POSTGRES_HOST}"
export PGPORT="${POSTGRES_PORT}"
export PGUSER="${POSTGRES_USER}"
export PGPASSWORD="${POSTGRES_PASSWORD}"
export PGDATABASE="${POSTGRES_DB}"

message_info "Checking the backup archive..."
if ! gzip --test "${backup_filename}"; then
    message_error "The backup archive is damaged. The '${POSTGRES_DB}' database was not touched."
    exit 1
fi

stamp="$(date +'%Y_%m_%dT%H_%M_%S')"
staging_db="${POSTGRES_DB}_restore_${stamp}"
previous_db="${POSTGRES_DB}_pre_restore_${stamp}"

message_info "Restoring into the staging database '${staging_db}'..."
createdb --owner="${POSTGRES_USER}" "${staging_db}"
# ON_ERROR_STOP + single transaction: any SQL error aborts the whole restore (psql otherwise exits 0).
if ! gunzip -c "${backup_filename}" | psql --quiet --set ON_ERROR_STOP=1 --single-transaction --dbname "${staging_db}" > /dev/null; then
    message_error "The restore failed. The '${POSTGRES_DB}' database was not touched; '${staging_db}' is left for inspection."
    exit 1
fi

message_info "Replacing '${POSTGRES_DB}' (kept as '${previous_db}')..."
psql --quiet --set ON_ERROR_STOP=1 --single-transaction --dbname postgres <<SQL
ALTER DATABASE "${POSTGRES_DB}" RENAME TO "${previous_db}";
ALTER DATABASE "${staging_db}" RENAME TO "${POSTGRES_DB}";
SQL

message_success "The '${POSTGRES_DB}' database has been restored from the '${backup_filename}' backup. The previous data is kept in '${previous_db}'; drop it once the restore is verified."
